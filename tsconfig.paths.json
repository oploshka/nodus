{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@app/*": [
        "src/app/*"
      ],
      "@engine/*": [
        "src/engine/*"
      ],
      "@model/*": [
        "src/model/*"
      ],
      "@test/*": [
        "test/*"
      ],
      "@target/*": [
        "target/*"
      ],
      "@benchmark/*": [
        "target/benchmark/*"
      ],
      "@mock/*": [
        "target/mock/*"
      ],
      "@project/*": [
        "target/project/*"
      ],
      "@test-framework/*": [
        "target/test-framework/*"
      ]
    }
  }
}
