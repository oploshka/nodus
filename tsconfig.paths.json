{
  "compilerOptions": {
    "baseUrl": ".",
    "types": [
      "node"
    ],
    "paths": {
      "@core/*": [
        "src/core/*"
      ],
      "@project/*": [
        "src/project/*"
      ],
      "@operation/*": [
        "src/operation/*"
      ],
      "@context/*": [
        "src/context/*"
      ],
      "@agent/*": [
        "src/agent/*"
      ],
      "@model/*": [
        "src/model/*"
      ],
      "@cli/*": [
        "src/cli/*"
      ],
      "@test/*": [
        "test/*"
      ],
      "@planner/*": [
        "src/planner/*"
      ],
      "@research/*": [
        "src/research/*"
      ],
      "@execution/*": [
        "src/execution/*"
      ]
    }
  }
}
