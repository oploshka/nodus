{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "src",
    "outDir": "dist",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    "esModuleInterop": true,
    "skipLibCheck": true,

    "sourceMap": true,
    "declaration": true,

    "forceConsistentCasingInFileNames": true,

    "baseUrl": ".",
    "paths": {
      "@core/*": ["./src/core/*"],
      "@knowledge/*": ["./src/knowledge/*"],
      "@project/*": ["./src/project/*"],
      "@model/*": ["./src/model/*"],
      "@tool/*": ["./src/tool/*"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}