{
  "project": {
    "id": "my-project",
    "root": "C:/Users/ectb0/OneDrive/Desktop/NODUS",
    "scanMode": "manual",
    "cachePath": ".nodus/cache/project-index.json",
    "knowledgePath": "knowledge.json",
    "include": ["src"],
    "exclude": ["node_modules", "dist", ".git", ".nodus"],
    "clearCacheOnStart": true
  },

  "model": {
    "provider": "openai-compatible",
    "endpoint": "http://127.0.0.1:5001/v1",
    "model": "koboldcpp",
    "temperature": 0.2,
    "maxTokens": 4096
  },

  "agent": {
    "maxSteps": 50,
    "responseLanguage": "auto",
    "internalLanguage": "original"
  },

  "knowledge": {
    "generationMode": "disabled"
  },

  "logging": {
    "level": "debug",
    "console": true,
    "consoleMode": "normal",
    "colors": true,
    "file": true,
    "path": ".nodus/log/nodus.log",
    "executionPath": ".nodus/log/executions",
    "modelPayload": true,
    "clearOnStart": true
  }
}