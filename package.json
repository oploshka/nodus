{
  "name": "nodus-runtime-spike",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:model": "vitest run --project model --passWithNoTests",
    "test:e2e": "vitest run --project e2e --passWithNoTests",
    "dev": "node dist/app/Main.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10"
  }
}
