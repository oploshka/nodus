    "test:protocol": "tsx src/test/NodusProtocolSmoke.ts",
    "test:protocol:model": "tsx src/test/NodusProtocolModelBenchmark.ts",
    "test:protocol:edit": "tsx src/test/EditFileProtocolSmoke.ts",
    "test:protocol:edit:model": "tsx src/test/EditFileProtocolModelBenchmark.ts",
    "test:edit-file:raw": "tsx src/test/EditFileRawProductionSmoke.ts",
    "test:plan:postcondition": "tsx src/test/PlanPostconditionSmoke.ts",
    "test:plan:satisfaction": "tsx src/test/PlanSemanticSatisfactionSmoke.ts",
    "test:step:evidence": "tsx src/test/StepEvidenceEvaluatorSmoke.ts",
    "test:startup:cleanup": "tsx src/test/StartupCleanupSmoke.ts",
    "test:understand:derivation": "tsx src/test/UnderstandDerivationSmoke.ts",
