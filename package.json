{
  "name": "nodus-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/Main.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc && tsc-alias -f",
    "start": "node dist/Main.js",
    "test:model": "tsx test/ModelSmoke.ts",
    "test:dataflow": "tsx test/ExecutionContextSmoke.ts",
    "test:protocol": "tsx test/NodusProtocolSmoke.ts",
    "test:protocol:model": "tsx test/NodusProtocolModelBenchmark.ts",
    "test:protocol:edit": "tsx test/EditFileProtocolSmoke.ts",
    "test:protocol:edit:model": "tsx test/EditFileProtocolModelBenchmark.ts",
    "test:edit-file:raw": "tsx test/EditFileRawProductionSmoke.ts",
    "test:plan:postcondition": "tsx test/PlanPostconditionSmoke.ts",
    "test:plan:satisfaction": "tsx test/PlanSemanticSatisfactionSmoke.ts",
    "test:step:evidence": "tsx test/StepEvidenceEvaluatorSmoke.ts",
    "test:startup:cleanup": "tsx test/StartupCleanupSmoke.ts",
    "test:understand:derivation": "tsx test/UnderstandDerivationSmoke.ts",
    "test:evidence:accumulation": "tsx test/ToolEvidenceAccumulationSmoke.ts",
    "test:derivation:grounding": "tsx test/ConservativeDerivationSmoke.ts",
    "test:edit-file:context": "tsx test/EditFileTargetContextSmoke.ts",
    "test:scenario:status": "tsx test/scenario/status/StatusCommandStepSuite.ts",
    "test:prompt:contracts": "tsx test/PromptTemperatureContractSmoke.ts",
    "test:operation:profiles": "tsx test/OperationProfileArchitectureSmoke.ts",
    "test:plan:actions": "tsx test/PlanActionWhitelistSmoke.ts",
    "test:search:deterministic": "tsx test/SearchDeterministicCompletionSmoke.ts",
    "test:model:input-messages": "tsx test/ModelInputMessagesSmoke.ts",
    "test:status:plan": "tsx test/scenario/status/PlanStageSmoke.ts",
    "test:status:search": "tsx test/scenario/status/SearchStageSmoke.ts",
    "test:status:understand": "tsx test/scenario/status/UnderstandStageSmoke.ts",
    "test:status:prepare": "tsx test/scenario/status/PrepareChangeStageSmoke.ts",
    "test:status:edit": "tsx test/scenario/status/EditStageSmoke.ts",
    "test:status:finalize": "tsx test/scenario/status/FinalizeStageSmoke.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsc-alias": "^1.8.10",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3"
  }
}
