{
  "project": {
    "id": "my-project",
    "root": ".",
    "scanMode": "on-open",
    "exclude": ["node_modules", "dist", ".git", ".nodus"]
  },
  "model": {
    "provider": "openai-compatible",
    "endpoint": "http://localhost:5001/v1",
    "model": "koboldcpp",
    "temperature": 0,
    "maxTokens": 4096,
    "requestTimeoutMs": 600000
  },
  "runtime": {
    "maxWorkerIterations": 8,
    "maxResearchActions": 3,
    "maxEditActions": 2
  }
}
