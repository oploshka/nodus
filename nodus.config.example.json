{
  "project": {
    "id": "example-project",
    "root": ".",
    "scanMode": "manual",
    "cachePath": ".nodus/cache/project-index.json",
    "knowledgePath": "knowledge.example.json",
    "include": [
      "src"
    ],
    "exclude": [
      "node_modules",
      "dist",
      ".git",
      ".nodus"
    ],
    "clearCacheOnStart": false
  },
  "model": {
    "provider": "mock",
    "endpoint": "http://127.0.0.1:11434/v1",
    "model": "local-model",
    "temperature": 0.2,
    "maxTokens": 4096,
    "messageLayout": "collapsed-user",
    "requestTimeoutMs": 600000
  },
  "agent": {
    "maxSteps": 20,
    "responseLanguage": "auto",
    "internalLanguage": "original"
  },
  "knowledge": {
    "generationMode": "disabled"
  },
  "logging": {
    "level": "info",
    "console": true,
    "file": false,
    "path": ".nodus/log/nodus.log",
    "modelPayload": false,
    "payloadPath": ".nodus/log/executions",
    "executionPath": ".nodus/log/executions",
    "consoleMode": "normal",
    "colors": true,
    "clearOnStart": false
  }
}
